{
  "name": "fluidbuddha-integrations-js",
  "private": true,
  "description": "Framework wrappers for the FluidBuddha widget (M2-10): @fluidbuddha/react and @fluidbuddha/vue.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.framer.json",
    "test": "node --test test/shared.test.mjs test/react.test.mjs test/vue.test.mjs",
    "audit": "npm audit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.44"
  }
}
