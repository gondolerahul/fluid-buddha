      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=17"
  },
  "keywords": ["fluidbuddha", "ai-agent", "chat", "voice", "react"],
  "license": "MIT"
}
