# ======================================================================
#  A2UI Backend Orchestrator — environment configuration
#  Copy to `.env` and fill in. With MOCK_AI=true the whole stack runs
#  locally with NO Google Cloud credentials (deterministic stub engines).
# ======================================================================

# ---- Runtime ----
APP_ENV=local
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the public widget API (/chat, /widget,
# ...): the sites embedding the widget. :3000 = hirebuddha marketing site,
# :3001 = admin console (Install tab test), :4000 = SDK demos. "*" is acceptable
# here — each request is also checked against the website's registered domain.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:4000,http://127.0.0.1:4000
# Origins allowed to call the admin API (/auth, /tenant): the console only.
ADMIN_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ---- Tenant auth (admin dashboard) ----
# Signs the JWT bearer tokens. The value below is the public dev default; the
# app REFUSES to boot with it when APP_ENV is not local/dev/test/ci, so set a
# real secret (e.g. `openssl rand -hex 32`) in any deployed environment.
JWT_SECRET=dev-fluid-buddha-secret-change-me-in-production-0001
JWT_EXPIRE_MIN=10080

# ---- Database (matches docker-compose.yml) ----
CORTEX_DB_URL=postgresql+asyncpg://cortex:cortex@localhost:5434/cortex

# ---- AI provider ----
# true  -> deterministic mock engines, no GCP needed (local dev / CI)
# false -> real Vertex AI (requires GOOGLE_CLOUD_PROJECT + ADC below)
MOCK_AI=true

# Vertex AI (used when MOCK_AI=false)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
# Path to a service-account JSON, OR run `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=

# Models (defaults match app/config.py and docker-compose.yml)
FAST_MODEL=gemini-2.5-flash
HEAVY_MODEL=gemini-2.5-pro
EMBED_MODEL=text-embedding-004      # MUST be 768-dim to match cortex schema
ASR_LANGUAGE=en-US
TTS_VOICE=en-US-Neural2-F
TTS_SAMPLE_RATE=24000

# ---- CORTEX grounding ----
# Stable identity for the memory scope (do not change once data is ingested).
CORTEX_COMPANY_ID=11111111-1111-1111-1111-111111111111
# Below which top-1 cosine similarity the agent must pivot ("we don't have X, but…")
CORTEX_CONFIDENCE_THRESHOLD=0.45
CORTEX_RETRIEVAL_TOP_K=5

# ---- Sync / UX ----
# If a UI component takes longer than this to render, frontend injects filler audio.
UI_FILLER_DELAY_MS=1500

# ---- Extreme intelligence (runtime page generation) ----
# Per-site design system + OpenAPI spec for the "container app" sites. Either set
# the exact file via <SITE>_DESIGN_SYSTEM / <SITE>_OPENAPI, or drop <site>.json
# files into DESIGN_SYSTEM_DIR / OPENAPI_DIR. With no live base URL, call_site_api
# responses are simulated deterministically.
# FLUIDBUDDHA_DESIGN_SYSTEM=../fluidbuddha-website/design/design-system.json
# FLUIDBUDDHA_OPENAPI=../fluidbuddha-website/apis/openapi.json
# FLUIDBUDDHA_CONTENT_DIR=../fluidbuddha-website/docs
# FLUIDBUDDHA_API_BASE_URL=
# FLUIDBUDDHA_API_AUTH=

# --- Trust layer: how often visitor data past each site's retention window
# is deleted (minutes; 0 = off). Retention itself is set per site.
RETENTION_SWEEP_MINUTES=60

# --- Self-serve onboarding (WS9): limits for "crawl my website".
# CRAWL_MAX_PAGES=50
# CRAWL_MAX_DEPTH=3
# CRAWL_CONCURRENCY=4
# Dev only: let the crawler and URL sources reach localhost / private
# addresses, to crawl a site running on your machine. Never in production.
# INGEST_ALLOW_PRIVATE_URLS=false

# --- Production plumbing (F-3). Everything below is optional.
# Shared chat sessions + rate limit for more than one backend replica.
# REDIS_URL=redis://localhost:6379/0
# SESSION_TTL_MINUTES=30
# One JSON object per log line (for a log shipper) instead of text.
# LOG_FORMAT=json
# Prometheus at /metrics; set a token to require "Authorization: Bearer <token>".
# METRICS_ENABLED=true
# METRICS_TOKEN=
# OpenTelemetry traces to an OTLP/HTTP collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=fluid-buddha-backend
# Sentry error reports (scrubbed of visitor text).
# SENTRY_DSN=
# RELEASE=

# --- Billing with Razorpay (WS12). Use test keys (rzp_test_…) in development.
# Without keys the console shows plans and usage but can't take payments.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# Set in Razorpay Dashboard → Webhooks for <your backend>/billing/razorpay/webhook
# (events: subscription.* and payment_link.paid)
# RAZORPAY_WEBHOOK_SECRET=
# Plan prices are in this currency's minor unit. The default catalog is in INR;
# USD needs international payments enabled on the Razorpay account.
# BILLING_CURRENCY=INR
# Override any plan field (app/billing/plans.py), e.g. USD prices:
# BILLING_CURRENCY=USD
# BILLING_CATALOG={"growth":{"price":39900,"overage":20},"scale":{"price":149900,"overage":12}}

# --- Email (M2-0): plain SMTP, any provider (Zoho, Google Workspace, SES, Brevo…).
# Without SMTP_HOST, dev environments log emails instead of sending them;
# other environments refuse to queue email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | ssl (port 465) | none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=FluidBuddha <no-reply@your-domain.com>
# EMAIL_OUTBOX_INTERVAL_SECONDS=15
# Console address used in email links (invitations, digests):
# CONSOLE_URL=https://console.your-domain.com
