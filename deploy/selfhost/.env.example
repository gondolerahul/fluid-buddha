# FluidBuddha self-hosted settings (M3-5). Copy to .env and fill in.
# bin/install.sh fills the secrets for you on a fresh install.

# ---- Names (DNS A/AAAA records pointing at this host) ----
API_DOMAIN=api.fluidbuddha.example.com
CONSOLE_DOMAIN=console.fluidbuddha.example.com
# Let's Encrypt contact (certificate expiry notices).
ACME_EMAIL=ops@example.com
# Your own certificates instead of Let's Encrypt (files in ./certs):
#   CADDY_TLS=tls /certs/fullchain.pem /certs/privkey.pem
# A trial on a private network with no public DNS (browsers will warn):
#   CADDY_TLS=tls internal
CADDY_TLS=
CADDY_GLOBAL_OPTIONS=

# ---- Licence (or install it later in the console: Account → Licence) ----
LICENCE_KEY=
# or a file mounted into the backend, e.g. /secrets/fluidbuddha.licence
LICENCE_FILE=

# ---- Secrets (generate: openssl rand -base64 48 / bin/install.sh) ----
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
# A Fernet key for stored secrets (API keys, webhook secrets):
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRETS_KEY=change-me
# Protects /metrics (Prometheus sends it as a bearer token).
METRICS_TOKEN=

# ---- AI models ----
# Vertex AI (speech, embeddings and, unless you bring your own, the agent):
# put the service account JSON in ./secrets and point at it.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/secrets/vertex-service-account.json
FAST_MODEL=gemini-2.5-flash
HEAVY_MODEL=gemini-2.5-pro
# true = no model at all (try the install end to end; answers are canned).
MOCK_AI=false
# The most the public widget may spend per site per day (USD).
PUBLIC_DAILY_SPEND_CAP_USD=50

# ---- Email (optional; without it, invitation links show in the console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=FluidBuddha <no-reply@example.com>

# ---- Voice handoff relay (optional; docker compose --profile voice up -d) ----
TURN_URLS=
TURN_SECRET=

# ---- Google sign-in (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Image tag for this install (bin/export-images.sh / bin/upgrade.sh set it).
FB_VERSION=local
