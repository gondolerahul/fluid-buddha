# Backend settings for production that aren't secret (docs/deployment/azure-production-plan.md §4).
# Reviewed in pull requests. On each deploy, vm/fluidbuddha-deploy adds the database and Redis
# addresses and the secrets from Key Vault, and writes the result to /opt/fluidbuddha/backend.env.
# One KEY=value per line; values are taken literally (no quotes, no expansion).

APP_ENV=production
SELF_HOSTED=false
MOCK_AI=false
LOG_FORMAT=json
STATUS_TITLE=FluidBuddha

# Addresses
PUBLIC_API_URL=https://gateway.fluidbuddha.com
CONSOLE_URL=https://app.fluidbuddha.com
WIDGET_SDK_BASE=https://gateway.fluidbuddha.com/sdk
CORS_ORIGINS=*
ADMIN_CORS_ORIGINS=https://app.fluidbuddha.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Capacity: two worker processes share chat sessions through Redis. Voice sessions get 25 s to
# finish their answer on a deploy.
WEB_CONCURRENCY=2
DRAIN_SECONDS=25

# AI on Google Vertex AI. One region serves the chat models, embeddings and Gemini TTS.
# The embedding model can't change after the first ingestion without re-embedding everything.
VERTEX_LOCATION=us-central1
FAST_MODEL=gemini-3.8-flash
HEAVY_MODEL=gemini-4-argon
EMBED_MODEL=text-embedding-004
ASR_LANGUAGE=en-US
TTS_VOICE=en-US-Neural2-F
TTS_SAMPLE_RATE=24000
PUBLIC_DAILY_SPEND_CAP_USD=25

# Voice handoff relay (coturn on the same VM).
TURN_URLS=turn:gateway.fluidbuddha.com:3478?transport=udp,turn:gateway.fluidbuddha.com:3478?transport=tcp

# Email: Microsoft 365 through Microsoft Graph. The GRAPH_* values come from Key Vault.
EMAIL_TRANSPORT=graph
SMTP_FROM=FluidBuddha <no-reply@fluidbuddha.com>

# Billing
BILLING_CURRENCY=INR
