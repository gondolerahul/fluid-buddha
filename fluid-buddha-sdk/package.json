{
  "name": "fluid-buddha",
  "version": "2.0.0",
  "description": "Framework-agnostic voice-first agentic UI overlay (<fluid-buddha>) — a Shadow-DOM Web Component injectable into any website via a single script tag.",
  "type": "module",
  "main": "./dist/fluid-buddha.cjs",
  "module": "./dist/fluid-buddha.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/fluid-buddha.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fluid-buddha.mjs",
      "require": "./dist/fluid-buddha.cjs"
    },
    "./global": "./dist/fluid-buddha.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules test/smoke.mjs",
    "serve:demo": "node build.mjs && python3 -m http.server 4000",
    "audit": "npm audit"
  },
  "keywords": [
    "voice",
    "web-component",
    "shadow-dom",
    "agent",
    "sdr",
    "a2ui",
    "vertex-ai"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "overrides": {
    "fflate": "^0.8.3"
  }
}
